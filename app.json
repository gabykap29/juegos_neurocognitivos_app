{
  "expo": {
    "name": "juegos_cognitivos",
    "slug": "juegos_cognitivos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "juegoscognitivos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gabykap.juegoscognitivos"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gabykap.juegoscognitivos"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71cdbe8e-fa49-4f9b-8b98-5825672f144a"
      }
    },
    "owner": "gabykap",
    "updates": {
      "url": "https://u.expo.dev/71cdbe8e-fa49-4f9b-8b98-5825672f144a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
